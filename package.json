{
  "name": "check-package-manager",
  "version": "0.0.0-development",
  "description": "Check that you're using the correct package manager",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webdeveric/check-package-manager.git"
  },
  "bugs": {
    "url": "https://github.com/webdeveric/check-package-manager/issues"
  },
  "homepage": "https://github.com/webdeveric/check-package-manager/#readme",
  "bin": {
    "check-package-manager": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    },
    "runtime": [
      {
        "name": "node",
        "version": "^26.12.1",
        "onFail": "download"
      }
    ]
  },
  "exports": {
    ".": null,
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf ./cache ./dist ./out-tsc",
    "demo": "./dist/cli.mjs",
    "format": "prettier --write .",
    "build": "cross-env NODE_ENV=production node --experimental-json-modules --no-warnings ./build.mjs",
    "build:dev": "cross-env NODE_ENV=development node --experimental-json-modules --no-warnings ./build.mjs",
    "typecheck": "tsc --build --force",
    "spellcheck": "cspell --no-progress \"./src/**/*.{ts,js,json}\" \"./*.{md,js,mjs,mts}\" \"./LICENSE\" \"./package.json\"",
    "lint": "eslint ./src ./*.{mjs,mts} --fix",
    "test": "vitest -c vitest.config.mts",
    "coverage": "vitest run  -c vitest.config.mts --coverage",
    "validate": "validate-package-exports --info --check --strict-module-type",
    "prepublishOnly": "pnpm typecheck && pnpm spellcheck && pnpm lint && pnpm coverage && pnpm build && pnpm validate",
    "prepare": "husky"
  },
  "keywords": [
    "package",
    "manager",
    "version",
    "packageManager",
    "corepack"
  ],
  "author": {
    "email": "eric@webdeveric.com",
    "name": "Eric King",
    "url": "http://webdeveric.com/"
  },
  "prettier": "@webdeveric/prettier-config",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@webdeveric/eslint-config-ts": "^0.12.1",
    "@webdeveric/prettier-config": "^0.4.0",
    "@webdeveric/utils": "^1.6.0",
    "commitlint": "^21.2.4",
    "commitlint-plugin-cspell": "^0.9.5",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-environment": "^0.5.0",
    "esbuild-plugin-node-externals": "^1.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "validate-package-exports": "^1.5.1",
    "vitest": "^5.0.5"
  }
}
